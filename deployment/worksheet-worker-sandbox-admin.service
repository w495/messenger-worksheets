[Unit]
Description=Messenger Worksheets Codex Worker (sandbox-admin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worksheet-chat-admin
Group=worksheet-chat-admin
WorkingDirectory=/opt/messenger-worksheets/app
Environment=PYTHONPATH=/opt/messenger-worksheets/app
Environment=HOME=/var/lib/messenger-worksheets-chat-admin
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
EnvironmentFile=/etc/messenger-worksheets/worker-sandbox-admin.env
ExecStart=/opt/messenger-worksheets/venv/bin/python -m messenger_worksheets.codex_rpc
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
StateDirectory=messenger-worksheets-chat-admin
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
